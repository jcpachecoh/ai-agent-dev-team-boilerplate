{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "stylelint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "email#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "email#preview": {
      "cache": false
    },
    "@restopsiq/mobile-client#build": {
      "outputs": []
    },
    "@restopsiq/mobile-manager#build": {
      "outputs": []
    },
    "@restopsiq/mobile-rider#build": {
      "outputs": []
    }
  }
}
