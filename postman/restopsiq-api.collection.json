{
  "info": {
    "_postman_id": "7c3e5f82-1a9b-4d6e-8f2c-0b5a3d7e9f1c",
    "name": "RestOpsIQ API",
    "description": "Complete API test collection for RestOpsIQ.\n\nCovers all 30 live endpoints across Health, Auth, Supply Items, and Testlab modules.\n\nGlobal prefix: /api\nAuth: JwtAuthGuard (APP_GUARD) — collection-level Bearer {{accessToken}}.\nPublic endpoints: GET /api/, POST /api/auth/signup, POST /api/auth/login, POST /api/auth/refresh.\nTenant-scoped endpoints: all /api/supply-items routes (x-tenant-id header).\n\nSee postman/README.md for prerequisites and setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Skip auto-login for public auth routes to avoid infinite loops",
          "const reqUrl = pm.request.url.toString();",
          "const isPublicAuthRoute =",
          "  reqUrl.includes('/auth/login') ||",
          "  reqUrl.includes('/auth/signup') ||",
          "  reqUrl.includes('/auth/refresh');",
          "if (isPublicAuthRoute) return;",
          "",
          "// Skip if token is still valid",
          "const expiry = pm.collectionVariables.get('accessTokenExpiresAt');",
          "if (expiry && Date.now() < Number(expiry)) return;",
          "",
          "// Auto-login",
          "const baseUrl  = pm.collectionVariables.get('baseUrl');",
          "const email    = pm.collectionVariables.get('email');",
          "const password = pm.collectionVariables.get('password');",
          "if (!baseUrl || !email || !password) return;",
          "",
          "pm.sendRequest({",
          "  url: baseUrl + '/api/auth/login',",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: { mode: 'raw', raw: JSON.stringify({ email, password }) }",
          "}, function (err, res) {",
          "  if (err || res.code !== 200) return;",
          "  const b = res.json();",
          "  pm.collectionVariables.set('accessToken', b.accessToken);",
          "  pm.collectionVariables.set('refreshToken', b.refreshToken);",
          "  // Treat token as valid for 14 minutes (access token TTL is 15 min)",
          "  pm.collectionVariables.set('accessTokenExpiresAt', String(Date.now() + 14 * 60 * 1000));",
          "});"
        ]
      }
    }
  ],
