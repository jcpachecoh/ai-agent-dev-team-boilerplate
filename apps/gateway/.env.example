PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://user:pass@localhost:5432/restopsiq"
# Set REDIS_ENABLED=true and provide REDIS_URL to activate Redis (rate-limiting + email queue)
# REDIS_ENABLED=true
# REDIS_URL=redis://localhost:6379
JWT_SECRET=your-super-secret-key-min-32-chars-here
JWT_EXPIRES_IN=8h
RESEND_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5175
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=1000
LOG_LEVEL=info
PROMETHEUS_PORT=9090
