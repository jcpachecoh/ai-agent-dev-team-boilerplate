# Demo KDS (sin backend): estación y PIN por defecto en dev
VITE_DEMO_STATION_ID=EST-02
VITE_DEMO_PIN=1234
# Habilitar modo demo en producción (acepta cualquier cédula/PIN)
VITE_ENABLE_DEMO_PIN=false

# Login plant — título principal (opcional)
# VITE_KDS_WELCOME_TITLE=Bienvenido al módulo de planta

# Plant REST API (dev proxy: /api → this host)
VITE_PLANT_API_URL=http://localhost:3001
VITE_PLANT_TENANT_ID=palos-de-lena

# Socket.io gateway
VITE_PLANT_WS_URL=http://localhost:3001

# Capgo (CI secrets — do not commit real keys)
VITE_CAPGO_CHANNEL=staging

# BLE scan filter (optional UUID, comma-separated). Leave empty to scan all devices.
# VITE_BLE_SCAN_SERVICE_UUID=
