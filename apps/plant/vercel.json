{
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @restopsiq/plant run build",
  "outputDirectory": "dist",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && exit 0; cd ../.. && npx turbo-ignore @restopsiq/plant",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
