# ─── Auth / Gateway API ──────────────────────────────────────────────────────
# REST API base URL (Vite proxies /api → gateway in dev; set for staging/prod)
# VITE_API_URL=http://localhost:4000
VITE_TENANT_ID=demo-tenant

# ─── GraphQL ─────────────────────────────────────────────────────────────────
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# ─── Inventory API ───────────────────────────────────────────────────────────
# Set VITE_USE_MOCK_INVENTORY=false and provide VITE_API_BASE_URL to use real API
VITE_USE_MOCK_INVENTORY=true
# VITE_API_BASE_URL=http://localhost:3001

# ─── Branding ────────────────────────────────────────────────────────────────
# Override the brand shown on the login page
# VITE_BRAND_NAME=RestOpsIQ
# VITE_BRAND_LOCATION=Planta Principal
# VITE_BRAND_INITIAL=R
