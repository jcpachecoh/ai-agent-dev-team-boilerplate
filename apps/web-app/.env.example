# ─── Auth / API ──────────────────────────────────────────────────────────────
# REST API base URL (Vite proxies /api → apps/api in dev; set for staging/prod)
# VITE_API_URL=http://localhost:3001
VITE_TENANT_ID=palos-de-lena

# ─── GraphQL ─────────────────────────────────────────────────────────────────
# Dev: omitir — Vite proxy /graphql → apps/api :3001/graphql
# VITE_GRAPHQL_URL=/graphql
# Optional explicit GraphQL proxy target in dev
# VITE_GRAPHQL_TARGET_URL=http://localhost:3001

# ─── Inventory API ───────────────────────────────────────────────────────────
# Set VITE_USE_MOCK_INVENTORY=false and provide VITE_API_BASE_URL to use real API
VITE_USE_MOCK_INVENTORY=true
# VITE_API_BASE_URL=http://localhost:3001

# ─── Plant / MES (órdenes de producción) ─────────────────────────────────────
# Credenciales operacionales para /api/plant/* (MES JWT). Seed palos-de-lena: owner cédula + PIN.
# VITE_MES_CEDULA=12345678
# VITE_MES_PIN=1234

# ─── Branding ────────────────────────────────────────────────────────────────
# VITE_DEMO_EMAIL=mes-owner@palos-de-lena.dev
# VITE_DEMO_PASSWORD=TestPass123!
# VITE_LOGIN_HERO_IMAGE=/custom-hero.webp
