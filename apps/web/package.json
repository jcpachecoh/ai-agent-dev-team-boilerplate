    "@types/react-dom": "^19.0.0",
    "eslint-config-next": "^16.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next-sitemap": "^4.2.3",
    "tailwindcss": "^4.3.3",
