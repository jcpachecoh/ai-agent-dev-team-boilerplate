# Database
POSTGRES_USER=restopsiq
POSTGRES_PASSWORD=restopsiq
POSTGRES_DB=restopsiq
POSTGRES_PORT=5432

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# App
NODE_ENV=development
PORT=3001

# Suppress @prisma/client's own postinstall auto-generate (we run prisma generate via root postinstall)
PRISMA_GENERATE_SKIP_AUTOINSTALL=true

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth — JWT secrets (use strong random values in production)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Jira
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=
OPENAI_MODEL=gpt-4o-mini

# Email (Resend) — used by EmailWorker, not required for EmailService queue-only mode
RESEND_API_KEY=re_your_key_here
RESEND_EMAIL_FROM=noreply@restopsiq.co
RESEND_FROM_NAME=Nico de OPSsynk
APP_URL=http://localhost:3000
