# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ndHGrNAVTLEZVEjnaWkBrRhlaPrymnVb
POSTGRES_DB=railway
POSTGRES_PORT=44926

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# App
NODE_ENV=development
PORT=3001

# Suppress @prisma/client's own postinstall auto-generate (we run prisma generate via root postinstall)
PRISMA_GENERATE_SKIP_AUTOINSTALL=true

# CORS — only plant app origins (this API serves the factory floor, not the web-app)
# In production: set to your deployed plant app URL
# Capacitor native (iOS/Android) is auto-allowed in NODE_ENV=development via main.ts
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:3000

# Auth — web/admin users (must NOT share values with MES secrets)
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# MES Auth — factory floor operators (cédula + PIN)
# Use DIFFERENT values from JWT_SECRET above
# Generate: openssl rand -base64 48
MES_JWT_SECRET=change-me-mes-in-production
MES_JWT_REFRESH_SECRET=change-me-mes-refresh-in-production
CEDULA_HMAC_SECRET=change-me-hmac-in-production

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Jira
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=
OPENAI_MODEL=gpt-4o-mini

# Storage — Cloudflare R2 (S3-compatible)
# R2_ENDPOINT format: https://<account_id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=restopsiq-assets
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://cdn.opssynk.com

# Email (Resend) — used by EmailWorker, not required for EmailService queue-only mode
RESEND_API_KEY=re_your_key_here
RESEND_EMAIL_FROM=noreply@restopsiq.co
RESEND_FROM_NAME=Nico de OPSsynk
APP_URL=http://localhost:3000
