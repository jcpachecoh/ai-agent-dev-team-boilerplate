# Database
POSTGRES_USER=restopsiq
POSTGRES_PASSWORD=restopsiq
POSTGRES_DB=restopsiq
POSTGRES_PORT=5432

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# App
NODE_ENV=development
PORT=3001

# Suppress @prisma/client's own postinstall auto-generate (we run prisma generate via root postinstall)
PRISMA_GENERATE_SKIP_AUTOINSTALL=true

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth — JWT secrets (use strong random values in production)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# Redis
REDIS_URL=redis://localhost:6379
