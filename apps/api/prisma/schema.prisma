  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  financialProfile EmployeeFinancialProfile @relation(fields: [financialProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, financialProfileId])
  @@map("employee_tax_information")
}

model EmployeePaymentHistory {
  id                   String                 @id @default(cuid())
  tenantId             String
  financialProfileId   String
  bankAccountId        String?
  periodYear           Int
  periodMonth          Int
  grossAmount          Decimal                @db.Decimal(12, 2)
  totalDeductions      Decimal                @db.Decimal(12, 2)
  netAmount            Decimal                @db.Decimal(12, 2)
  deductionBreakdown   Json?
