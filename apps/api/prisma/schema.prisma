// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORAGE
// ─────────────────────────────────────────────────────────────────────────────

enum StorageProviderType {
  CLOUDFLARE_R2
  LOCAL
}

enum StorageVisibility {
  PUBLIC
  PRIVATE
}

enum StorageDomain {
  BRANDING
  INVENTORY
  PRODUCTION
  RECIPES
  PAYROLL
  SUPPLIERS
  USERS
}

enum StorageObjectStatus {
  ACTIVE
  DELETED
}

model StorageObject {
  id           String              @id @default(cuid())
  tenantId     String
  provider     StorageProviderType
  bucket       String
  key          String              @unique
  mimeType     String
  size         Int
  checksum     String
  etag         String?
  originalName String
  domain       StorageDomain
  entityType   String?
  entityId     String?
  uploadedBy   String
  visibility   StorageVisibility   @default(PUBLIC)
  status       StorageObjectStatus @default(ACTIVE)
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  employeePhotos            EmployeeDetails[]
  supplierDocumentVersions  SupplierDocumentVersion[]
  employeeAssets            EmployeeAsset[]
  employeeDocuments         EmployeeDocument[]
  vacationRequestLetters    VacationRequest[]
  medicalLeaveSupportDocs   MedicalLeave[]
  payrollNovedadSupportDocs PayrollNovedad[]

  @@index([tenantId])
  @@index([tenantId, domain])
  @@index([tenantId, status])
  @@index([entityType, entityId])
  @@index([deletedAt])
  @@map("storage_objects")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
  APPROVE
  REJECT
  ASSIGN
}

model AuditLog {
  id          String      @id @default(cuid())
  tenantId    String
  actorUserId String?
  userId      String?
  action      AuditAction
  entityType  String      @map("entity")
  entityId    String
  payload     Json?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  // userId is kept as a plain reference for legacy data

  @@index([tenantId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// LOGIN AUDIT (USR-05)
// ─────────────────────────────────────────────────────────────────────────────

enum AuthMethod {
  PASSWORD
  PIN
  REFRESH_TOKEN
  OAUTH_GOOGLE
}

enum LoginAuditStatus {
  SUCCESS
  FAILED
  LOCKED
  LOGOUT
}

model LoginAudit {
  id            String           @id @default(cuid())
  tenantId      String
  userId        String?
  identifier    String
  authMethod    AuthMethod
  status        LoginAuditStatus
  failureReason String?
  ipAddress     String?
  userAgent     String?
  deviceInfo    Json?
  createdAt     DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("login_audits")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPLIERS
// ─────────────────────────────────────────────────────────────────────────────

enum SupplierTipo {
  PERSONA_NATURAL
  PERSONA_JURIDICA
}

enum CondicionPago {
  CONTADO
  DIAS_15
  DIAS_30
  DIAS_60
}

enum SupplierDocumentType {
  RUT
  CAMARA_COMERCIO
  CEDULA_REPRESENTANTE_LEGAL
  CERTIFICACION_BANCARIA
  LISTA_PRECIOS
  CONTRATO_COMERCIAL
  POLIZAS
  CERTIFICACION_SANITARIA
  CONCEPTO_SANITARIO_INVIMA
  FICHA_TECNICA_PRODUCTO
  HOJA_SEGURIDAD
  CERTIFICADO_BPM
  ACUERDO_CONFIDENCIALIDAD
  TRATAMIENTO_DATOS_PERSONALES
}

enum SupplierDocumentStatus {
  PENDING
  UPLOADED
  EXPIRING
  EXPIRED
}

enum SupplierDeliveryMode {
  SUPPLIER_DELIVERS
  COMPANY_PICKUP
}

enum SupplierDeliveryPlace {
  PLANT
  PDV
  WAREHOUSE
  OTHER
}

enum SupplierTransportType {
  OWN
  THIRD_PARTY
}

enum SupplierLogisticsStatus {
  DRAFT
  COMPLETE
}

enum SupplierTransportCostCurrency {
  COP
  USD
}

model Supplier {
  id                     String        @id @default(cuid())
  tenantId               String
  razonSocial            String
  nit                    String
  dv                     String?
  tipo                   SupplierTipo
  direccion              String?
  departamento           String?
  ciudad                 String?
  telefono               String?
  email                  String?
  contactoNombre         String?
  condicionPago          CondicionPago
  cupoCredito            Int
  calificacion           Decimal
  isCritical             Boolean       @default(false)
  sellsRecurrentProducts Boolean       @default(false)
  isFoodSupplier         Boolean       @default(false)
  handlesChemicals       Boolean       @default(false)
  isRawMaterialSupplier  Boolean       @default(false)
  isActive               Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  products  SupplierProduct[]
  documents SupplierDocument[]
  logistics SupplierLogistics?

  @@unique([tenantId, nit])
  @@index([tenantId, isActive])
  @@map("suppliers")
}

model SupplierDocument {
  id               String                 @id @default(cuid())
  tenantId         String
  supplierId       String
  documentType     SupplierDocumentType
  status           SupplierDocumentStatus @default(PENDING)
  issuedAt         DateTime?              @db.Date
  expiresAt        DateTime?              @db.Date
  lastUploadedAt   DateTime?
  uploadedByUserId String?
  currentVersionId String?                @unique
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  supplier       Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  uploadedBy     User?                     @relation("SupplierDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  currentVersion SupplierDocumentVersion?  @relation("SupplierDocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       SupplierDocumentVersion[] @relation("SupplierDocumentVersions")

  @@unique([tenantId, supplierId, documentType])
  @@index([tenantId, supplierId])
  @@index([tenantId, expiresAt])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("supplier_documents")
}

model SupplierDocumentVersion {
  id                 String    @id @default(cuid())
  tenantId           String
  supplierDocumentId String
  storageObjectId    String
  versionNumber      Int
  uploadedByUserId   String?
  uploadedAt         DateTime  @default(now())
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  supplierDocument   SupplierDocument   @relation("SupplierDocumentVersions", fields: [supplierDocumentId], references: [id], onDelete: Cascade)
  storageObject      StorageObject      @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)
  uploadedBy         User?              @relation("SupplierDocumentVersionUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  currentForDocument SupplierDocument[] @relation("SupplierDocumentCurrentVersion")

  @@unique([tenantId, supplierDocumentId, versionNumber])
  @@index([tenantId, supplierDocumentId])
  @@index([tenantId, uploadedAt])
  @@index([tenantId, deletedAt])
  @@map("supplier_document_versions")
}

model SupplierDocumentPolicy {
  tenantId                   String   @id
  camaraComercioValidityDays Int      @default(30)
  rutAnnualReviewMonths      Int      @default(11)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("supplier_document_policies")
}

model SupplierLogistics {
  id                         String                         @id @default(cuid())
  tenantId                   String
  supplierId                 String                         @unique
  deliveryMode               SupplierDeliveryMode?
  deliveryPlace              SupplierDeliveryPlace?
  deliveryPlaceCustom        String?
  deliveryDays               Int[]                          @default([])
  leadTimeDays               Int?
  timeWindowStart            String?
  timeWindowEnd              String?
  receptionResponsibleUserId String?
  transportType              SupplierTransportType?
  requiresColdChain          Boolean                        @default(false)
  transportTempMinC          Decimal?                       @db.Decimal(5, 2)
  transportTempMaxC          Decimal?                       @db.Decimal(5, 2)
  transportCost              Decimal?                       @db.Decimal(12, 2)
  transportCostCurrency      SupplierTransportCostCurrency?
  minimumOrderQty            Decimal?                       @db.Decimal(12, 2)
  minimumOrderUnit           String?
  status                     SupplierLogisticsStatus        @default(DRAFT)
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  supplier                 Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  receptionResponsibleUser User?                       @relation("SupplierLogisticsReceptionResponsible", fields: [receptionResponsibleUserId], references: [id], onDelete: SetNull)
  coverageLocations        SupplierLogisticsCoverage[]

  @@index([tenantId])
  @@index([receptionResponsibleUserId])
  @@map("supplier_logistics")
}

model SupplierLogisticsCoverage {
  supplierLogisticsId String
  locationId          String
  tenantId            String
  createdAt           DateTime @default(now())

  supplierLogistics SupplierLogistics @relation(fields: [supplierLogisticsId], references: [id], onDelete: Cascade)
  location          Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([supplierLogisticsId, locationId])
  @@index([tenantId])
  @@index([locationId])
  @@map("supplier_logistics_coverage")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPLY CATEGORIES
// ─────────────────────────────────────────────────────────────────────────────

model SupplyCategory {
  id          String   @id @default(cuid())
  tenantId    String
  nombre      String
  prefijo     String
  descripcion String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items SupplyItem[]

  @@unique([tenantId, nombre])
  @@unique([tenantId, prefijo])
  @@index([tenantId, isActive])
  @@map("supply_categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// INSUMOS (SUPPLY ITEMS)
// ─────────────────────────────────────────────────────────────────────────────

enum StockUnit {
  UNIT
  GRAMS
  KILOGRAMS
  ML
  LITERS
  BOX
}

model SupplyItem {
  id                     String    @id @default(cuid())
  tenantId               String
  nombre                 String
  codigoInterno          String
  categoriaId            String
  descripcion            String?
  unidadBase             StockUnit
  factorConversion       Decimal
  costoPromedioPonderado Decimal
  stockMinimoBodega      Decimal
  stockMaximoBodega      Decimal
  stockActualBodega      Decimal   @default(0)
  aplicaVencimiento      Boolean   @default(false)
  aplicaLote             Boolean   @default(false)
  fechaVencimiento       DateTime?
  lote                   String?
  locationId             String?
  subcategoria           String?
  genero                 String?
  talla                  String?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  categoria          SupplyCategory             @relation(fields: [categoriaId], references: [id])
  location           Location?                  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplierProducts   SupplierProduct[]
  priceHistory       SupplyItemPriceHistory[]
  orderMaterials     ProductionOrderMaterial[]
  alertResolutions   InventoryAlertResolution[]
  compositionLines   RecipeCompositionLine[]
  dotacionDeliveries DotacionDelivery[]

  @@unique([tenantId, codigoInterno])
  @@index([tenantId, categoriaId])
  @@index([tenantId, isActive])
  @@index([tenantId, locationId])
  @@map("supply_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPLIER PRODUCTS
// ─────────────────────────────────────────────────────────────────────────────

model SupplierProduct {
  id                   String    @id @default(cuid())
  tenantId             String
  supplierId           String
  supplyItemId         String
  precioUnitario       Decimal
  unidadCompra         StockUnit
  factorConversion     Decimal
  tiempoEntregaDias    Int
  esProveedorPrincipal Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplyItem SupplyItem @relation(fields: [supplyItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierId, supplyItemId])
  @@index([tenantId, supplierId])
  @@index([tenantId, supplyItemId])
  @@map("supplier_products")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRICE HISTORY
// ─────────────────────────────────────────────────────────────────────────────

model SupplyItemPriceHistory {
  id               String   @id @default(cuid())
  tenantId         String
  supplyItemId     String
  costoAnterior    Decimal
  costoNuevo       Decimal
  cantidadRecibida Decimal?
  stockAnterior    Decimal?
  stockNuevo       Decimal?
  motivo           String?
  referenciaTipo   String?
  referenciaId     String?
  createdBy        String?
  createdAt        DateTime @default(now())

  supplyItem SupplyItem @relation(fields: [supplyItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, supplyItemId])
  @@index([tenantId, createdAt])
  @@map("supply_item_price_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY ALERT RESOLUTIONS
// ─────────────────────────────────────────────────────────────────────────────

enum InventoryAlertType {
  LOW_STOCK
}

model InventoryAlertResolution {
  id           String             @id @default(cuid())
  tenantId     String
  supplyItemId String
  alertType    InventoryAlertType @default(LOW_STOCK)
  resolvedAt   DateTime           @default(now())
  resolvedById String?
  note         String?

  supplyItem SupplyItem @relation(fields: [supplyItemId], references: [id])

  @@index([tenantId, supplyItemId, resolvedAt])
  @@index([tenantId, resolvedAt])
  @@map("inventory_alert_resolutions")
}

// ─────────────────────────────────────────────────────────────────────────────
// PASSWORD RESET TOKENS
// ─────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// GLOBAL IDENTITY — ROLES & DOCUMENT TYPES (USR-01)
// ─────────────────────────────────────────────────────────────────────────────

enum DocumentType {
  CC
  CE
  PASAPORTE
  TI
  PEP
}

model Tenant {
  id                                String        @id @default(cuid())
  name                              String
  nit                               String?       @unique
  legalName                         String?
  tradeName                         String?
  legalRepresentativeName           String?
  legalRepresentativeDocumentType   DocumentType?
  legalRepresentativeDocumentNumber String?
  email                             String?
  phone                             String?
  address                           String?
  city                              String?
  department                        String?
  country                           String        @default("CO")
  taxRegime                         String?
  logoUrl                           String?
  openingTime                       String?
  closingTime                       String?
  isActive                          Boolean       @default(true)
  createdAt                         DateTime      @default(now())
  updatedAt                         DateTime      @updatedAt
  deletedAt                         DateTime?

  tenantLocations Location[]

  @@index([isActive])
  @@map("tenants")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("roles")
}

model User {
  id                String       @id @default(cuid())
  tenantId          String
  cedula            String
  documentType      DocumentType
  email             String
  passwordHash      String
  roleId            String
  loginAttempts     Int          @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  refreshToken      String?
  isActive          Boolean      @default(true)
  emailVerified     Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  createdBy         String?

  role Role @relation(fields: [roleId], references: [id])

  employeeDetails                       EmployeeDetails?
  operationalProfile                    OperationalUser?
  userPermissions                       UserPermission[]
  userLocations                         UserLocation[]
  loginAudits                           LoginAudit[]
  auditLogs                             AuditLog[]
  committeeMemberships                  ProductionCommitteeMember[]
  turnosCreated                         Turno[]                     @relation("TurnoCreatedBy")
  turnosUpdated                         Turno[]                     @relation("TurnoUpdatedBy")
  turnoAssignmentsCreated               TurnoAssignment[]           @relation("TurnoAssignmentCreatedBy")
  turnoAssignmentsUpdated               TurnoAssignment[]           @relation("TurnoAssignmentUpdatedBy")
  employeeShiftAssignmentsCreated       EmployeeShiftAssignment[]   @relation("EmployeeShiftAssignmentCreatedBy")
  employeeShiftAssignmentsUpdated       EmployeeShiftAssignment[]   @relation("EmployeeShiftAssignmentUpdatedBy")
  supplierDocumentsUploaded             SupplierDocument[]          @relation("SupplierDocumentUploadedBy")
  supplierDocumentVersionsUploaded      SupplierDocumentVersion[]   @relation("SupplierDocumentVersionUploadedBy")
  supplierLogisticsReceptionResponsible SupplierLogistics[]         @relation("SupplierLogisticsReceptionResponsible")
  attendanceLogsCreated                 AttendanceLog[]             @relation("AttendanceLogCreatedBy")
  attendanceObservationsCreated         AttendanceObservation[]     @relation("AttendanceObservationCreatedBy")
  attendanceObservationsUpdated         AttendanceObservation[]     @relation("AttendanceObservationUpdatedBy")
  overtimeApprovals                     OvertimeApproval[]          @relation("OvertimeApprovalApprover")

  @@unique([tenantId, email])
  @@unique([tenantId, cedula])
  @@index([tenantId, roleId])
  @@index([isActive])
  @@index([tenantId, isActive])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOMINA COLOMBIA (NOM-01)
// ─────────────────────────────────────────────────────────────────────────────

enum EmployeeContractType {
  FIJO
  INDEFINIDO
  OBRA
  PRESTACION
  APRENDIZAJE
}

enum SalaryType {
  ORDINARIO
  INTEGRAL
}

enum ArlRiskLevel {
  RIESGO_I
  RIESGO_II
  RIESGO_III
  RIESGO_IV
  RIESGO_V
}

enum MaritalStatus {
  SOLTERO
  CASADO
  UNION_LIBRE
  DIVORCIADO
  VIUDO
}

enum Gender {
  MASCULINO
  FEMENINO
  OTRO
}

enum EmployeeCatalogType {
  EPS
  ARL
  PENSION_FUND
  CESANTIAS_FUND
  CAJA_COMPENSACION
  AREA
  DEPARTMENT
}

model Location {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  address             String
  city                String?
  phone               String?
  code                String?
  latitude            String?
  longitude           String?
  // Geo fields for mobile attendance geofencing (OS-499/OS-505).
  // latitude/longitude kept as String? for backwards compat; new Float fields used for math.
  geoLatitude         Float?
  geoLongitude        Float?
  checkInRadiusMeters Int?
  businessHours       Json?
  openingTime         String?
  closingTime         String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant                     Tenant                      @relation(fields: [tenantId], references: [id])
  users                      UserLocation[]
  employeeDetails            EmployeeDetails[]
  attendanceLogs             AttendanceLog[]
  productionIncidents        ProductionIncident[]
  supplyItems                SupplyItem[]
  productionRecipes          ProductionRecipeLocation[]
  supplierLogisticsCoverage  SupplierLogisticsCoverage[]
  turnos                     Turno[]
  overtimeRequests           OvertimeRequest[]
  dailyCostCenterAssignments DailyCostCenterAssignment[]
  jornadaCutoffs             JornadaCutoff[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("locations")
}

model UserLocation {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  tenantId   String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([tenantId])
  @@index([locationId])
  @@map("user_locations")
}

model EmployeeDetails {
  id                   String               @id @default(cuid())
  userId               String               @unique
  tenantId             String
  name                 String
  locationId           String?
  positionId           String?
  position             String
  area                 String
  department           String
  contractType         EmployeeContractType
  hireDate             DateTime
  contractStart        DateTime
  contractEnd          DateTime?
  salaryType           SalaryType
  salaryAmount         Decimal              @db.Decimal(12, 2)
  hasTransportSubsidy  Boolean              @default(false)
  isExemptFromTax      Boolean              @default(false)
  epsName              String
  pensionFundName      String
  cesantiasFundName    String
  arlName              String
  arlRiskLevel         ArlRiskLevel
  cajaCompensacion     String
  barrio               String?
  localidad            String?
  costCenter           CostCenter           @default(OPERACIONES)
  laborClassification  LaborClassification  @default(ADMINISTRATIVO)
  nonSalaryAmount      Decimal?             @db.Decimal(12, 2)
  pinHash              String?
  photoStorageObjectId String?
  portalWorkerEnabled  Boolean              @default(false)
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?

  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  location                   Location?                   @relation(fields: [locationId], references: [id])
  positionRef                EmployeePosition?           @relation(fields: [positionId], references: [id], onDelete: SetNull)
  photoStorageObject         StorageObject?              @relation(fields: [photoStorageObjectId], references: [id], onDelete: SetNull)
  positionHistory            EmployeePositionHistory[]
  salaryHistory              EmployeeSalaryHistory[]
  fundHistory                EmployeeFundHistory[]
  assets                     EmployeeAsset[]
  documents                  EmployeeDocument[]
  attendanceLogs             AttendanceLog[]
  attendanceObservations     AttendanceObservation[]
  socialProfiles             EmployeeSocialProfile[]
  financialProfile           EmployeeFinancialProfile?
  personalData               EmployeePersonalData?
  turnoAssignments           TurnoAssignment[]
  employeeShiftAssignments   EmployeeShiftAssignment[]
  vacationBalance            VacationBalance?
  vacationRequests           VacationRequest[]
  medicalLeaves              MedicalLeave[]
  cesantiasLiquidations      CesantiasLiquidation[]
  payrollNovedades           PayrollNovedad[]
  overtimeRequests           OvertimeRequest[]
  jornadaCutoffs             JornadaCutoff[]
  dataConsents               DataConsent[]
  dailyCostCenterAssignments DailyCostCenterAssignment[]
  employmentContracts        EmploymentContract[]
  primaLiquidations          PrimaLiquidation[]
  finalSettlements           FinalSettlement[]

  @@index([tenantId])
  @@index([locationId])
  @@index([positionId])
  @@index([contractType])
  @@index([isActive])
  @@index([tenantId, costCenter])
  @@index([tenantId, laborClassification])
  @@map("employee_details")
}

model EmployeePersonalData {
  id                           String         @id @default(cuid())
  tenantId                     String
  employeeDetailsId            String         @unique
  nombres                      String?
  primerApellido               String?
  segundoApellido              String?
  fechaNacimiento              DateTime?      @db.Date
  estadoCivil                  MaritalStatus?
  sexo                         Gender?
  departamento                 String?
  ciudad                       String?
  localidad                    String?
  barrio                       String?
  direccion                    String?
  telefono                     String?
  contactoEmergenciaNombre     String?
  contactoEmergenciaTelefono   String?
  contactoEmergenciaParentesco String?
  profilePhotoStorageObjectId  String?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  employee EmployeeDetails @relation(fields: [employeeDetailsId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("employee_personal_data")
}

model EmployeePosition {
  id              String   @id @default(cuid())
  tenantId        String
  title           String
  area            String
  baseSalaryRange Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employees EmployeeDetails[]
  history   EmployeePositionHistory[]

  supervisorLinks  EmployeePositionSupervisor[] @relation("PositionSupervisorPositions")
  subordinateLinks EmployeePositionSupervisor[] @relation("SupervisorPositionSubordinates")

  @@unique([tenantId, title])
  @@index([tenantId, isActive])
  @@index([tenantId, area])
  @@map("employee_positions")
}

// OS-550 follow-up — Organigrama de supervisión por cargo (Cargo → Cargo supervisor).
// Decisión de producto: la jerarquía se modela entre CARGOS, no entre personas — no existe
// `EmployeeDetails.supervisorId`. `findSubordinatePositionIds` (repository) recorre esta tabla
// para acotar el filtro Supervisor del listado de colaboradores por cargos subordinados,
// además del scoping de sede ya existente vía UserLocation.
model EmployeePositionSupervisor {
  id                   String   @id @default(cuid())
  tenantId             String
  positionId           String
  supervisorPositionId String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  position           EmployeePosition @relation("PositionSupervisorPositions", fields: [positionId], references: [id], onDelete: Cascade)
  supervisorPosition EmployeePosition @relation("SupervisorPositionSubordinates", fields: [supervisorPositionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, positionId, supervisorPositionId])
  @@index([tenantId, positionId])
  @@index([tenantId, supervisorPositionId])
  @@map("employee_position_supervisors")
}

model EmployeePositionHistory {
  id                String    @id @default(cuid())
  tenantId          String
  employeeDetailsId String
  positionId        String
  effectiveFrom     DateTime  @default(now())
  effectiveTo       DateTime?
  changedBy         String?
  createdAt         DateTime  @default(now())

  employee EmployeeDetails  @relation(fields: [employeeDetailsId], references: [id], onDelete: Cascade)
  position EmployeePosition @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeDetailsId])
  @@index([tenantId, positionId])
  @@index([employeeDetailsId, effectiveFrom])
  @@map("employee_position_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// OS-588 (fase infraestructura) — Historial salarial y de fondos de afiliación.
// Mismo patrón de vigencias que EmployeePositionHistory (effectiveFrom/effectiveTo,
// un único registro abierto por empleado, cerrado y reemplazado por el service en la
// misma transacción que el update de EmployeeDetails). EmployeeDetails.salaryAmount/
// salaryType/cesantiasFundName/pensionFundName se mantienen como snapshot vigente
// (los sigue leyendo NOM-04 sin cambios); estas tablas son la fuente para reconstruir
// el valor aplicable en cualquier fecha pasada.
// ─────────────────────────────────────────────────────────────────────────────

model EmployeeSalaryHistory {
  id                String     @id @default(cuid())
  tenantId          String
  employeeDetailsId String
  salaryType        SalaryType
  salaryAmount      Decimal    @db.Decimal(12, 2)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  changedBy         String?
  createdAt         DateTime   @default(now())

  employee EmployeeDetails @relation(fields: [employeeDetailsId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeDetailsId])
  @@index([employeeDetailsId, effectiveFrom])
  @@map("employee_salary_history")
}

// `fundType` reutiliza EmployeeCatalogType (mismo enum del catálogo de picklists en
// EmployeeCatalogOption) en vez de crear un enum paralelo. Solo se escriben las variantes
// CESANTIAS_FUND y PENSION_FUND — el resto del enum (EPS, ARL, CAJA_COMPENSACION, AREA,
// DEPARTMENT) no aplica a este modelo pero Prisma no permite subconjuntos de enum.
model EmployeeFundHistory {
  id                String              @id @default(cuid())
  tenantId          String
  employeeDetailsId String
  fundType          EmployeeCatalogType
  fundName          String
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  changedBy         String?
  createdAt         DateTime            @default(now())

  employee EmployeeDetails @relation(fields: [employeeDetailsId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeDetailsId, fundType])
  @@index([employeeDetailsId, fundType, effectiveFrom])
  @@map("employee_fund_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// OS-591 (fase 1 — fundaciones) — Historial contractual.
//
// A diferencia de EmployeeSalaryHistory/EmployeeFundHistory (que versionan un ATRIBUTO
// de un único contrato implícito), EmploymentContract modela cada CONTRATO como una fila
// propia — necesario para soportar recontrataciones (más de un contrato para el mismo
// empleado a lo largo del tiempo) sin perder cuál contrato originó cada liquidación.
//
// EmployeeDetails.contractType/contractStart/contractEnd NO se eliminan en esta fase
// (siguen siendo el snapshot vigente que ya consume el resto de NOM-04/OS-588/OS-589) —
// este modelo es la fuente de verdad para HISTORIAL de contratos, sincronizada con esos
// campos en el mismo flujo de create/update (ver PayrollRepository).
//
// "Un solo contrato ACTIVO por empleado" se hace cumplir en dos capas:
//  1. Aplicación: EmployeeContractRepository valida antes de escribir.
//  2. Base de datos: `activeSlot` es NULL para todo contrato TERMINADO y `true` únicamente
//     mientras status=ACTIVO — Postgres no compara NULL como igual a NULL en un índice
//     único, así que @@unique([tenantId, employeeDetailsId, activeSlot]) solo puede
//     chocar entre dos filas ACTIVO, nunca entre TERMINADOs (mismo truco que
//     "partial unique index" sin necesitar SQL crudo en el schema).
// ─────────────────────────────────────────────────────────────────────────────

enum EmploymentContractStatus {
  ACTIVO
  TERMINADO
}

// CST art. 61/64 — motivo de terminación. Determina si la indemnización (fase 2) aplica:
// RENUNCIA, JUSTA_CAUSA, MUTUO_ACUERDO y VENCIMIENTO_TERMINO producen indemnización = 0
// en el alcance base del ticket OS-591; SIN_JUSTA_CAUSA es el único que activa la fórmula.
enum ContractTerminationReason {
  RENUNCIA
  JUSTA_CAUSA
  SIN_JUSTA_CAUSA
  MUTUO_ACUERDO
  VENCIMIENTO_TERMINO
  MUERTE_TRABAJADOR
  OTRA
}

model EmploymentContract {
  id                String                     @id @default(cuid())
  tenantId          String
  employeeDetailsId String
  contractType      EmployeeContractType
  startDate         DateTime
  // Fecha pactada de vencimiento (FIJO/OBRA) — snapshot al momento de firmar/editar el
  // contrato. No confundir con `terminationDate` (fecha REAL de cierre, cualquier tipo).
  agreedEndDate     DateTime?
  status            EmploymentContractStatus   @default(ACTIVO)
  terminationDate   DateTime?
  terminationReason ContractTerminationReason?
  terminationNotes  String?
  // true solo mientras status=ACTIVO; NULL en TERMINADO — ver nota de unicidad arriba.
  activeSlot        Boolean?                   @default(true)
  changedBy         String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  employee         EmployeeDetails   @relation(fields: [employeeDetailsId], references: [id], onDelete: Restrict)
  finalSettlements FinalSettlement[]

  @@unique([tenantId, employeeDetailsId, activeSlot])
  @@index([tenantId])
  @@index([tenantId, employeeDetailsId])
  @@index([employeeDetailsId, startDate])
  @@index([tenantId, status])
  @@map("employment_contracts")
}

model EmployeeAsset {
  id              String      @id @default(cuid())
  tenantId        String
  employeeId      String
  assetName       String
  type            AssetType
  assignmentDate  DateTime    @default(now())
