  qaApprovedAt      DateTime?
  qaApprovedBy      String?
  startedAt         DateTime?
  completedAt       DateTime?
  notes             String?
  operatorCount     Int?
  deliveredQuantity Decimal?             @db.Decimal(10, 3)
  responsibleUserId String?
  createdAt         DateTime             @default(now())

  order           ProductionOrder      @relation(fields: [orderId], references: [id])
  phase           ProductionPhase      @relation(fields: [phaseId], references: [id])
  workStation     WorkStation          @relation(fields: [workStationId], references: [id])
  responsibleUser OperationalUser?     @relation("ExecutionResponsible", fields: [responsibleUserId], references: [id])
  sessions        OperatorSession[]
  alarmDispatches PlantAlarmDispatch[]
  incidents       ProductionIncident[]
  productionLogs  ProductionLog[]

