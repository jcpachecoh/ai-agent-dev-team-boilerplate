  employee      EmployeeDetails @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  storageObject StorageObject?  @relation(fields: [storageObjectId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, status])
  @@index([employeeId, status])
  @@index([tenantId, type])
  @@index([storageObjectId])
  @@map("employee_assets")
}

enum AssetStatus {
