model RecipeImage {
  id              String   @id @default(cuid())
  tenantId        String
  recipeId        String
  alt             String?
  nameImage       String
  url             String
  storageObjectId String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipe ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipeId])
  @@index([tenantId, recipeId, isActive])
  @@index([tenantId, isActive])
  @@map("recipes_images")
}

model ProductionPhase {
  id              String  @id @default(cuid())
  tenantId        String
  recipeId        String
  workStationId   String
  order           Int
  name            String
  description     String?
  standardMinutes Int
  minOperators    Int     @default(1)
  maxOperators    Int     @default(4)
  requiresQA      Boolean @default(false)

  recipe     ProductionRecipe @relation(fields: [recipeId], references: [id])
  station    WorkStation      @relation(fields: [workStationId], references: [id])
  inputs     PhaseInput[]
  executions PhaseExecution[]

  @@index([recipeId, order])
  @@map("production_phases")
}

model PhaseInput {
  id               String    @id @default(cuid())
  tenantId         String
  phaseId          String
  supplyItemId     String
  quantityPerBatch Decimal   @db.Decimal(10, 3)
  unit             StockUnit
  isOptional       Boolean   @default(false)

  phase ProductionPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
  @@map("phase_inputs")
}

model OperatorSession {
  id               String    @id @default(cuid())
  tenantId         String
  workStationId    String
  operatorUserId   String
  phaseExecutionId String?
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  createdAt        DateTime  @default(now())

  station        WorkStation     @relation(fields: [workStationId], references: [id])
  operator       OperationalUser @relation(fields: [operatorUserId], references: [id])
  phaseExecution PhaseExecution? @relation(fields: [phaseExecutionId], references: [id])

  @@index([tenantId])
  @@index([workStationId])
  @@index([operatorUserId])
  @@index([phaseExecutionId])
  @@map("operator_sessions")
}

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  IN_PROCESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProductionPriority {
  NORMAL
  HIGH
  URGENT
}

enum ProductionShift {
  MORNING
  AFTERNOON
  NIGHT
}

enum PhaseExecutionStatus {
  PENDING
  READY
  IN_PROCESS
  PAUSED
  QA_PENDING
  COMPLETED
}

enum ProductionLogEvent {
  ORDER_STARTED
  ORDER_PAUSED
  ORDER_RESUMED
  STEP_COMPLETED
  ORDER_COMPLETED
  NOVELTY_ADDED
}

enum PlantAlarmType {
  TIEMPO_EXCEDIDO
  FASE_SIN_OPERARIO
  OP_RETRASADA
}

enum AlarmSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentType {
