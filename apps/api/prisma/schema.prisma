// ─────────────────────────────────────────────────────────────────────────────

enum NovedadType {
  AUSENCIA_INJUSTIFICADA
  LICENCIA_LUTO
  LICENCIA_PATERNIDAD
  LICENCIA_MATERNIDAD
  LICENCIA_NO_REMUNERADA
  PERMISO_REMUNERADO
  CALAMIDAD_DOMESTICA
  DIA_FAMILIA
}

enum NovedadRequestSource {
  EMPLEADO
  RRHH
}

enum NovedadStatus {
  SOLICITADA
  PENDIENTE_SUPERVISOR
  PENDIENTE_RRHH
  APROBADA
  RECHAZADA
}

model PayrollNovedad {
  id                     String               @id @default(cuid())
  tenantId               String
  employeeId             String
  type                   NovedadType
  startDate              DateTime             @db.Date
  endDate                DateTime             @db.Date
  isPaid                 Boolean
  linkedLeaveId          String?
  supportStorageObjectId String?
  notes                  String?
  requestedBy            NovedadRequestSource
  status                 NovedadStatus        @default(SOLICITADA)
  supervisorApproverId   String?
  supervisorDecisionAt   DateTime?
  supervisorComment      String?
  rrhhApproverId         String?
  rrhhDecisionAt         DateTime?
  rejectionReason        String?
  overlapWarningAck      Boolean              @default(false)
  sourceAttendanceLogId  String?              @unique
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?

  employee            EmployeeDetails @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  supportDocument     StorageObject?  @relation(fields: [supportStorageObjectId], references: [id], onDelete: SetNull)
  sourceAttendanceLog AttendanceLog?  @relation("PayrollNovedadSourceAttendanceLog", fields: [sourceAttendanceLogId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, startDate, endDate])
  @@index([tenantId, type])
  @@index([tenantId, sourceAttendanceLogId])
  @@map("payroll_novedades")
}

model NovedadTypeConfig {
  id                         String      @id @default(cuid())
  tenantId                   String
  type                       NovedadType
  requiresSupervisorApproval Boolean     @default(false)
  requiresSupportDocument    Boolean     @default(false)
  isPaidDefault              Boolean     @default(true)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("novedad_type_configs")
}
