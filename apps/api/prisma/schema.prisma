  COMUN
  LABORAL
}

enum LeaveStatus {
  REGISTRADA
  RADICADA_EPS
  RECOBRADA
  RECHAZADA
}

model MedicalLeave {
  id                     String      @id @default(cuid())
  tenantId               String
  employeeId             String
  origin                 LeaveOrigin
  startDate              DateTime    @db.Date
  endDate                DateTime    @db.Date
  totalDays              Int
  employerPaidDays       Int
  epsArlPaidDays         Int
  epsArlAmount           Decimal?    @db.Decimal(12, 2)
  employerAmount         Decimal     @db.Decimal(12, 2)
  supportStorageObjectId String?
  status                 LeaveStatus @default(REGISTRADA)
  radicatedAt            DateTime?
  recoveredAt            DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  sourceAttendanceLogId  String?     @unique
  createdAt              DateTime    @default(now())
