  order      ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplyItem SupplyItem?     @relation(fields: [supplyItemId], references: [id])

  @@unique([orderId, supplyItemId])
  @@index([orderId])
  @@index([tenantId, orderId])
