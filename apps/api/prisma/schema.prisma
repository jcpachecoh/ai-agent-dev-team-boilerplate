// ─────────────────────────────────────────────────────────────────────────────
// NÓMINA — CONTROL DE ASISTENCIA (NOM-03)
// ─────────────────────────────────────────────────────────────────────────────

enum AttendanceEventType {
  ENTRY
  EXIT
}

// Definido independientemente de ProductionShift (dominio MES) para evitar
// acoplamiento entre módulos de planta y nómina.
enum AttendanceShift {
  MORNING // 06:00–14:00
  AFTERNOON // 14:00–22:00
  NIGHT // 22:00–06:00
}

// Clasificación de horas extra según CST colombiano.
// Usado en Task 02 (service) para cálculo de recargos.
// FESTIVO_DIURNO / FESTIVO_NOCTURNO requieren calendario de festivos (NOM-04).
enum AttendanceOvertimeType {
  REGULAR // Jornada ordinaria (≤ 8h/día)
  DIURNO // Extra diurna 06:00–21:00 — recargo 25% CST art. 168
  NOCTURNO // Extra nocturna 21:00–06:00 — recargo 75% CST art. 168
  FESTIVO_DIURNO // Trabajo en festivo diurno — recargo 75% CST art. 179
  FESTIVO_NOCTURNO // Trabajo en festivo nocturno — recargo 150% CST art. 179
}

// ASIS-UNI — origen de la marcación (fuente de verdad única).
// APP_MOVIL: app móvil (facial + geo, OS-499/OS-505).
// MANUAL: registro/corrección por administrador (OS-551/OS-554); insert-only vía manualParentLogId.
// DEVICE: legacy kiosko NOM-03 — deprecado; en migración ASIS-UNI se mapea semánticamente a APP_MOVIL
// (UPDATE opcional en backfill); no registrar nuevos DEVICE en producto final.
enum AttendanceLogSource {
  DEVICE // @deprecated legacy — usar APP_MOVIL
  APP_MOVIL
  MANUAL
}

// Estado de validación geo/facial (principalmente source=APP_MOVIL).
enum AttendanceValidationStatus {
  VALID // Dentro del radio configurado
  REJECTED // Fuera de radio u otro rechazo
  PENDING // Sede sin geofence — revisión manual
}

model AttendanceLog {
  id         String              @id @default(cuid())
  tenantId   String
  employeeId String
  locationId String
  eventType  AttendanceEventType
  shift      AttendanceShift?
  timestamp  DateTime            @default(now())
  // workDate: fecha de jornada (sin hora), normalizada a America/Bogota.
  // Se asigna por ENTRY; el EXIT hereda la workDate del ENTRY abierto
  // para soportar turnos nocturnos que cruzan medianoche.
  workDate   DateTime
  notes      String?
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  source            AttendanceLogSource @default(DEVICE)
  createdByUserId   String?
  manualReason      String?
  manualParentLogId String?

  // ASIS-UNI — metadata app móvil (source=APP_MOVIL); opcional en MANUAL/DEVICE legacy
  validationStatus  AttendanceValidationStatus?
  clientLatitude    Float?
  clientLongitude   Float?
  distanceMeters    Float?
  radiusMeters      Int?
  storageObjectId   String?
  photoUrl          String?
  facialMatchScore  Float?
  facialMatchResult String?
  rejectionReason   String?

  employee EmployeeDetails @relation(fields: [employeeId], references: [id])
  location Location        @relation(fields: [locationId], references: [id])

  createdBy       User?           @relation("AttendanceLogCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  manualParentLog AttendanceLog?  @relation("AttendanceLogManualParent", fields: [manualParentLogId], references: [id], onDelete: SetNull)
  manualChildLogs AttendanceLog[] @relation("AttendanceLogManualParent")

  payrollNovedadFromSource PayrollNovedad? @relation("PayrollNovedadSourceAttendanceLog")
  medicalLeaveFromSource   MedicalLeave?   @relation("MedicalLeaveSourceAttendanceLog")

  @@index([tenantId, employeeId, workDate])
  @@index([tenantId, locationId, workDate])
  @@index([tenantId, workDate])
  @@index([tenantId, validationStatus])
  @@index([manualParentLogId])
  @@map("attendance_logs")
}

// OS-551 — una observación por empleado + fecha de jornada, persistida y auditada
// (ver AuditLog para el historial de creación/edición).
model AttendanceObservation {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  workDate   DateTime @db.Date
  note       String   @db.VarChar(500)

  createdByUserId String?
  updatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  EmployeeDetails @relation(fields: [employeeId], references: [id])
  createdBy User?           @relation("AttendanceObservationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?           @relation("AttendanceObservationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeId, workDate])
  @@index([tenantId, employeeId, workDate])
  @@map("attendance_observations")
}

// ─────────────────────────────────────────────────────────────────────────────
// NÓMINA — TURNOS (NOM-08)
// ─────────────────────────────────────────────────────────────────────────────

enum TurnoTipo {
  PERMANENTE
  VARIABLE
}

enum TurnoJornada {
  DIURNO
  NOCTURNO
  MIXTO
}

model Turno {
  id              String       @id @default(cuid())
  tenantId        String
  locationId      String
  nombre          String       @db.VarChar(100)
  sigla           String       @db.VarChar(30)
  tipo            TurnoTipo
  jornada         TurnoJornada
  horaInicio      String
  horaFin         String
  daysOfWeek      Int[]        @default([1, 2, 3, 4, 5])
  estado          Boolean      @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  location            Location                  @relation(fields: [locationId], references: [id])
  createdBy           User?                     @relation("TurnoCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy           User?                     @relation("TurnoUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  assignments         TurnoAssignment[]
  employeeAssignments EmployeeShiftAssignment[]

  @@unique([tenantId, sigla])
  @@index([tenantId, estado])
  @@index([tenantId, nombre])
  @@index([tenantId, locationId])
  @@map("turnos")
}

// SHIFT-UNI: vigencia de turno base por empleado (asistencia + nómina).
model EmployeeShiftAssignment {
  id              String    @id @default(cuid())
  tenantId        String
  employeeId      String
  turnoId         String
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  turno     Turno           @relation(fields: [turnoId], references: [id])
  employee  EmployeeDetails @relation(fields: [employeeId], references: [id])
  createdBy User?           @relation("EmployeeShiftAssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?           @relation("EmployeeShiftAssignmentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, turnoId])
  @@map("employee_shift_assignments")
}

enum TurnoAssignmentType {
  ASSIGNED
  REST
}

model TurnoAssignment {
  id              String              @id @default(cuid())
  tenantId        String
  turnoId         String?
  employeeId      String
  workDate        DateTime            @db.Date
  type            TurnoAssignmentType @default(ASSIGNED)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  turno     Turno?          @relation(fields: [turnoId], references: [id])
