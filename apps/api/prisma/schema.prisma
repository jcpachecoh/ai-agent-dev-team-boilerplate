// ── Mobile Attendance removed (ASIS-UNI Task 05) — data lives in AttendanceLog ─

model ProductionOrderMaterial {
  id               String    @id @default(cuid())
  tenantId         String
  orderId          String
  supplyItemId     String?
  materialName     String
  lotNumber        String?
  requiredQuantity Decimal   @db.Decimal(10, 3)
  consumedQuantity Decimal?  @db.Decimal(10, 3)
  unit             StockUnit
