  producedQuantity Decimal?              @db.Decimal(10, 3)
  unit             StockUnit
  plannedStartAt   DateTime
  plannedEndAt     DateTime
  actualStartAt    DateTime?
  actualEndAt      DateTime?
  supervisorId     String?
  notes            String?
  lotNumber        String?
