  sedeId        String?
  isActive      Boolean         @default(true)
  loginAttempts Int             @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  refreshToken  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user                  User?                @relation(fields: [userId], references: [id])
  operatorSessions      OperatorSession[]
  reportedIncidents     ProductionIncident[] @relation("IncidentReporter")
  resolvedIncidents     ProductionIncident[] @relation("IncidentResolver")
  responsibleExecutions PhaseExecution[]     @relation("ExecutionResponsible")
  productionLogs        ProductionLog[]

