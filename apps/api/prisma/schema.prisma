// ─────────────────────────────────────────────────────────────────────────────
// OS-588 (fase 2) — Liquidación anual de cesantías e intereses.
//
// Un registro por (employeeId, year). Cesantías e intereses son dos obligaciones legales
// independientes (la primera se consigna al fondo, la segunda se paga directo al
// trabajador) — por eso tienen su propio enum de estado en vez de uno combinado. No hay
// `deletedAt`: igual que EmployeePaymentHistory (el precedente más cercano de un registro
// financiero legal en este schema), un registro calculado no se borra — se ANULA vía
// estado. `fundNameSnapshot`/`fundChannelSnapshot` capturan el fondo vigente al cierre del
// periodo (ver EmployeeFundHistory) y no cambian aunque el empleado cambie de fondo
// después — la liquidación ya cerrada no se recalcula por eso.
// ─────────────────────────────────────────────────────────────────────────────

enum CesantiasSettlementStatus {
  CALCULADA
  CONSIGNADA
  ANULADA
}

enum CesantiasInterestStatus {
  CALCULADO
  PAGADO
  ANULADO
}

// Canal de consignación derivado del nombre del fondo al momento del cálculo (heurística:
// "Fondo Nacional del Ahorro" → FNA, cualquier otro nombre del catálogo → PRIVATE_OPERATOR).
// No existe hoy una columna de canal en EmployeeCatalogOption/EmployeeFundHistory — si el
// catálogo llegara a tener un nombre distinto para el FNA (typo, tenant con nombre custom),
// esta heurística lo clasificaría mal. Ver tasks/OS-588.md.
enum CesantiasFundChannel {
  FNA
  PRIVATE_OPERATOR
}

model CesantiasLiquidation {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  year        Int
  periodStart DateTime @db.Date
  // Fin real considerado: min(31-dic-year, contractEnd, hoy) — ver CesantiasCalculationService.
  periodEnd   DateTime @db.Date

  // Días causados en convención comercial de 360 (30 días/mes) — DIVISOR_CESANTIAS.
  accrualDays Int

  // Base ponderada informativa: Σ(baseTramo × díasTramo) / Σdías — no es la fuente del
  // cálculo, solo un resumen para mostrar/auditar (el cálculo real suma cada tramo por
  // separado, ver tasks/OS-588.md).
  calculationBase Decimal @db.Decimal(12, 2)

  cesantiasAmount      Decimal @db.Decimal(14, 2)
  interestAmount       Decimal @db.Decimal(14, 2)
  // Snapshot de INTERES_CESANTIAS (LaborLegalParameter) vigente al cierre — trazabilidad
  // si la tasa cambia en el futuro.
  interestRateSnapshot Decimal @db.Decimal(6, 4)

  fundNameSnapshot    String
  fundChannelSnapshot CesantiasFundChannel

  cesantiasStatus CesantiasSettlementStatus @default(CALCULADA)
  interestStatus  CesantiasInterestStatus   @default(CALCULADO)

  calculatedBy String?
  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee EmployeeDetails @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, year])
  @@index([tenantId, year])
  @@index([tenantId, employeeId])
  @@index([tenantId, cesantiasStatus])
  @@index([tenantId, interestStatus])
  @@map("cesantias_liquidations")
}

// ─────────────────────────────────────────────────────────────────────────────
// OS-591 (fase 1 — fundaciones) — Prima de servicios (CST art. 306, dominio "NOM-08" del
// ticket — no confundir con `tasks/nom-08-turnos-backend`, que es un dominio distinto ya
// existente en este repo con la misma numeración informal, ver tasks/OS-591.md).
//
// Un registro por (employeeId, year, half) — semestre calendario (1-jun / 1-dic-31),
// mismo criterio de "no se borra, se ANULA vía estado" que CesantiasLiquidation. A
// diferencia de cesantías (un solo monto + intereses), prima solo tiene un concepto
// monetario, pero SÍ necesita rastrear pagos (`paidAmount`) de forma acumulativa para que
// `getPrimaBalanceAsOf` pueda derivar saldo pendiente y sobrepago sin una tabla aparte de
// pagos — ver PrimaService.
//
// A diferencia de CesantiasService.calculateForYear (batch de todo el tenant, con el
// riesgo de recalcular/afectar a otros empleados ya documentado en tasks/OS-588.md), este
// dominio se diseñó desde el inicio por EMPLEADO — ver PrimaService.calculateForEmployee.
// ─────────────────────────────────────────────────────────────────────────────

enum PrimaHalf {
  PRIMER_SEMESTRE
  SEGUNDO_SEMESTRE
}

enum PrimaSettlementStatus {
  CALCULADA
  PAGADA
  ANULADA
}

model PrimaLiquidation {
  id          String    @id @default(cuid())
  tenantId    String
  employeeId  String
  year        Int
  half        PrimaHalf
  periodStart DateTime  @db.Date
  // Fin real considerado: min(30-jun/31-dic-year, contractEnd, hoy) — igual criterio que
  // CesantiasLiquidation.periodEnd.
  periodEnd   DateTime  @db.Date

  // Días causados en convención comercial (30/mes) — PRIMA_DIVISOR_DIAS (180 = semestre).
  accrualDays Int

  // Base ponderada informativa — mismo criterio que CesantiasLiquidation.calculationBase
  // (no es la fuente del cálculo, solo resumen para mostrar/auditar).
  calculationBase Decimal @db.Decimal(12, 2)

  accruedAmount Decimal @db.Decimal(14, 2)
  // Acumulado de pagos registrados contra esta liquidación (puede ser parcial o, si hubo
  // sobrepago, mayor que accruedAmount — ver PrimaService.getPrimaBalanceAsOf).
  paidAmount    Decimal @default(0) @db.Decimal(14, 2)

  // Snapshot de PRIMA_DIVISOR_DIAS (LaborLegalParameter) vigente al cierre — trazabilidad
  // si el divisor cambiara en el futuro.
  divisorSnapshot Decimal @db.Decimal(6, 2)

  status PrimaSettlementStatus @default(CALCULADA)

  calculatedBy String?
  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee EmployeeDetails @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, year, half])
  @@index([tenantId, year, half])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("prima_liquidations")
}

