// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORAGE
// ─────────────────────────────────────────────────────────────────────────────

enum StorageProviderType {
  CLOUDFLARE_R2
  LOCAL
}

enum StorageVisibility {
  PUBLIC
  PRIVATE
}

enum StorageDomain {
  BRANDING
  INVENTORY
  PRODUCTION
  RECIPES
  PAYROLL
  USERS
}

enum StorageObjectStatus {
  ACTIVE
  DELETED
}

model StorageObject {
  id           String              @id @default(cuid())
  tenantId     String
  provider     StorageProviderType
  bucket       String
  key          String              @unique
  mimeType     String
  size         Int
  checksum     String
  etag         String?
  originalName String
  domain       StorageDomain
  entityType   String?
  entityId     String?
  uploadedBy   String
  visibility   StorageVisibility   @default(PUBLIC)
  status       StorageObjectStatus @default(ACTIVE)
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  @@index([tenantId])
  @@index([tenantId, domain])
  @@index([tenantId, status])
  @@index([entityType, entityId])
  @@index([deletedAt])
  @@map("storage_objects")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
  APPROVE
  REJECT
  ASSIGN
}

model AuditLog {
  id          String      @id @default(cuid())
  tenantId    String
  actorUserId String?
  userId      String?
  action      AuditAction
  entityType  String      @map("entity")
  entityId    String
  payload     Json?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  // userId is kept as a plain reference for legacy data

  @@index([tenantId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// LOGIN AUDIT (USR-05)
// ─────────────────────────────────────────────────────────────────────────────

enum AuthMethod {
  PASSWORD
  PIN
  REFRESH_TOKEN
  OAUTH_GOOGLE
}

enum LoginAuditStatus {
  SUCCESS
  FAILED
  LOCKED
  LOGOUT
}

model LoginAudit {
  id            String           @id @default(cuid())
  tenantId      String
  userId        String?
  identifier    String
  authMethod    AuthMethod
  status        LoginAuditStatus
  failureReason String?
  ipAddress     String?
  userAgent     String?
  deviceInfo    Json?
  createdAt     DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("login_audits")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPLIERS
// ─────────────────────────────────────────────────────────────────────────────

enum SupplierTipo {
  PERSONA_NATURAL
  PERSONA_JURIDICA
}

enum CondicionPago {
  CONTADO
  DIAS_15
  DIAS_30
  DIAS_60
}

model Supplier {
  id             String        @id @default(cuid())
  tenantId       String
  razonSocial    String
  nit            String
  dv             String?
  tipo           SupplierTipo
  direccion      String?
  departamento   String?
  ciudad         String?
  telefono       String?
  email          String?
  contactoNombre String?
  condicionPago  CondicionPago
  cupoCredito    Int
  calificacion   Decimal
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  products SupplierProduct[]

  @@unique([tenantId, nit])
  @@index([tenantId, isActive])
  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPLY CATEGORIES
// ─────────────────────────────────────────────────────────────────────────────

model SupplyCategory {
  id          String   @id @default(cuid())
  tenantId    String
  nombre      String
  prefijo     String
  descripcion String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items SupplyItem[]

  @@unique([tenantId, nombre])
  @@unique([tenantId, prefijo])
  @@index([tenantId, isActive])
  @@map("supply_categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// INSUMOS (SUPPLY ITEMS)
// ─────────────────────────────────────────────────────────────────────────────

enum StockUnit {
  UNIT
  GRAMS
  KILOGRAMS
  ML
  LITERS
  BOX
}

model SupplyItem {
  id                     String    @id @default(cuid())
  tenantId               String
  nombre                 String
  codigoInterno          String
  categoriaId            String
  descripcion            String?
  unidadBase             StockUnit
  factorConversion       Decimal
  costoPromedioPonderado Decimal
  stockMinimoBodega      Decimal
  stockMaximoBodega      Decimal
  stockActualBodega      Decimal   @default(0)
  aplicaVencimiento      Boolean   @default(false)
  aplicaLote             Boolean   @default(false)
  fechaVencimiento       DateTime?
  lote                   String?
  locationId             String?
  subcategoria           String?
  genero                 String?
  talla                  String?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  categoria        SupplyCategory             @relation(fields: [categoriaId], references: [id])
  location         Location?                  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplierProducts SupplierProduct[]
  priceHistory     SupplyItemPriceHistory[]
  orderMaterials   ProductionOrderMaterial[]
  alertResolutions InventoryAlertResolution[]
  compositionLines RecipeCompositionLine[]

  @@unique([tenantId, codigoInterno])
  @@index([tenantId, categoriaId])
  @@index([tenantId, isActive])
  @@index([tenantId, locationId])
  @@map("supply_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPLIER PRODUCTS
// ─────────────────────────────────────────────────────────────────────────────

model SupplierProduct {
  id                   String    @id @default(cuid())
  tenantId             String
  supplierId           String
  supplyItemId         String
  precioUnitario       Decimal
  unidadCompra         StockUnit
  factorConversion     Decimal
  tiempoEntregaDias    Int
  esProveedorPrincipal Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplyItem SupplyItem @relation(fields: [supplyItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierId, supplyItemId])
  @@index([tenantId, supplierId])
  @@index([tenantId, supplyItemId])
  @@map("supplier_products")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRICE HISTORY
// ─────────────────────────────────────────────────────────────────────────────

model SupplyItemPriceHistory {
  id               String   @id @default(cuid())
  tenantId         String
  supplyItemId     String
  costoAnterior    Decimal
  costoNuevo       Decimal
  cantidadRecibida Decimal?
  stockAnterior    Decimal?
  stockNuevo       Decimal?
  motivo           String?
  referenciaTipo   String?
  referenciaId     String?
  createdBy        String?
  createdAt        DateTime @default(now())

  supplyItem SupplyItem @relation(fields: [supplyItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, supplyItemId])
  @@index([tenantId, createdAt])
  @@map("supply_item_price_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY ALERT RESOLUTIONS
// ─────────────────────────────────────────────────────────────────────────────

enum InventoryAlertType {
  LOW_STOCK
}

model InventoryAlertResolution {
  id           String             @id @default(cuid())
  tenantId     String
  supplyItemId String
  alertType    InventoryAlertType @default(LOW_STOCK)
  resolvedAt   DateTime           @default(now())
  resolvedById String?
  note         String?

  supplyItem SupplyItem @relation(fields: [supplyItemId], references: [id])

  @@index([tenantId, supplyItemId, resolvedAt])
  @@index([tenantId, resolvedAt])
  @@map("inventory_alert_resolutions")
}

// ─────────────────────────────────────────────────────────────────────────────
// PASSWORD RESET TOKENS
// ─────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// GLOBAL IDENTITY — ROLES & DOCUMENT TYPES (USR-01)
// ─────────────────────────────────────────────────────────────────────────────

enum DocumentType {
  CC
  CE
  PASAPORTE
  TI
  PEP
}

model Tenant {
  id                                String        @id @default(cuid())
  name                              String
  nit                               String?       @unique
  legalName                         String?
  tradeName                         String?
  legalRepresentativeName           String?
  legalRepresentativeDocumentType   DocumentType?
  legalRepresentativeDocumentNumber String?
  email                             String?
  phone                             String?
  address                           String?
  city                              String?
  department                        String?
  country                           String        @default("CO")
  taxRegime                         String?
  logoUrl                           String?
  openingTime                       String?
  closingTime                       String?
  isActive                          Boolean       @default(true)
  createdAt                         DateTime      @default(now())
  updatedAt                         DateTime      @updatedAt
  deletedAt                         DateTime?

  tenantLocations Location[]

  @@index([isActive])
  @@map("tenants")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("roles")
}

model User {
  id                String       @id @default(cuid())
  tenantId          String
  cedula            String
  documentType      DocumentType
  email             String
  passwordHash      String
  roleId            String
  loginAttempts     Int          @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  refreshToken      String?
  isActive          Boolean      @default(true)
  emailVerified     Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  createdBy         String?

  role Role @relation(fields: [roleId], references: [id])

  employeeDetails      EmployeeDetails?
  operationalProfile   OperationalUser?
  userPermissions      UserPermission[]
  userLocations        UserLocation[]
  loginAudits          LoginAudit[]
  auditLogs            AuditLog[]
  committeeMemberships ProductionCommitteeMember[]

  @@unique([tenantId, email])
  @@unique([tenantId, cedula])
  @@index([tenantId, roleId])
  @@index([isActive])
  @@index([tenantId, isActive])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOMINA COLOMBIA (NOM-01)
// ─────────────────────────────────────────────────────────────────────────────

enum EmployeeContractType {
  FIJO
  INDEFINIDO
  OBRA
  PRESTACION
  APRENDIZAJE
}

enum SalaryType {
  ORDINARIO
  INTEGRAL
}

enum ArlRiskLevel {
  RIESGO_I
  RIESGO_II
  RIESGO_III
  RIESGO_IV
  RIESGO_V
}

enum EmployeeCatalogType {
  EPS
  ARL
  PENSION_FUND
  CESANTIAS_FUND
  CAJA_COMPENSACION
  AREA
  DEPARTMENT
}

model Location {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  address       String
  city          String?
  phone         String?
  code          String?
  latitude      String?
  longitude     String?
  businessHours Json?
  openingTime   String?
  closingTime   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant              Tenant                     @relation(fields: [tenantId], references: [id])
  users               UserLocation[]
  employeeDetails     EmployeeDetails[]
  attendanceLogs      AttendanceLog[]
  productionIncidents ProductionIncident[]
  supplyItems         SupplyItem[]
  productionRecipes   ProductionRecipeLocation[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("locations")
}

model UserLocation {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  tenantId   String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([tenantId])
  @@index([locationId])
  @@map("user_locations")
}

model EmployeeDetails {
  id                  String               @id @default(cuid())
  userId              String               @unique
  tenantId            String
  name                String
  locationId          String
  positionId          String?
  position            String
  area                String
  department          String
  contractType        EmployeeContractType
  hireDate            DateTime
  contractStart       DateTime
  contractEnd         DateTime?
  salaryType          SalaryType
  salaryAmount        Decimal              @db.Decimal(12, 2)
  hasTransportSubsidy Boolean              @default(false)
  isExemptFromTax     Boolean              @default(false)
  epsName             String
  pensionFundName     String
  cesantiasFundName   String
  arlName             String
  arlRiskLevel        ArlRiskLevel
  cajaCompensacion    String
  pinHash             String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location         Location                  @relation(fields: [locationId], references: [id])
  positionRef      EmployeePosition?         @relation(fields: [positionId], references: [id], onDelete: SetNull)
  positionHistory  EmployeePositionHistory[]
  attendanceLogs   AttendanceLog[]
  socialProfiles   EmployeeSocialProfile[]
  financialProfile EmployeeFinancialProfile?

  @@index([tenantId])
  @@index([locationId])
  @@index([positionId])
  @@index([contractType])
  @@index([isActive])
  @@map("employee_details")
}

model EmployeePosition {
  id              String   @id @default(cuid())
  tenantId        String
  title           String
  area            String
  baseSalaryRange Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employees EmployeeDetails[]
  history   EmployeePositionHistory[]

  @@unique([tenantId, title])
  @@index([tenantId, isActive])
  @@index([tenantId, area])
  @@map("employee_positions")
}

model EmployeePositionHistory {
  id                String    @id @default(cuid())
  tenantId          String
  employeeDetailsId String
  positionId        String
  effectiveFrom     DateTime  @default(now())
  effectiveTo       DateTime?
  changedBy         String?
  createdAt         DateTime  @default(now())

  employee EmployeeDetails  @relation(fields: [employeeDetailsId], references: [id], onDelete: Cascade)
  position EmployeePosition @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeDetailsId])
  @@index([tenantId, positionId])
  @@index([employeeDetailsId, effectiveFrom])
  @@map("employee_position_history")
}

enum EmployeeRelationshipType {
  SPOUSE
  CHILD
  FATHER
  MOTHER
  OTHER
}

model EmployeeSocialProfile {
  id                String                   @id @default(cuid())
  tenantId          String
  employeeDetailsId String
  fullName          String
  relationshipType  EmployeeRelationshipType
  birthDate         DateTime
  isDependent       Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?

  employeeDetails EmployeeDetails @relation(fields: [employeeDetailsId], references: [id], onDelete: Cascade)

  @@unique([employeeDetailsId, fullName, relationshipType, birthDate])
  @@index([tenantId, employeeDetailsId])
  @@index([deletedAt])
  @@map("employee_social_profiles")
}

model EmployeeCatalogOption {
  id        String              @id @default(cuid())
  tenantId  String
  type      EmployeeCatalogType
  name      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([tenantId, type, name])
  @@index([tenantId, type, isActive])
  @@map("employee_catalog_options")
}

// ─────────────────────────────────────────────────────────────────────────────
// NÓMINA — PERFIL FINANCIERO DEL EMPLEADO (OS-559)
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
}

enum BankAccountType {
  SAVINGS
  CHECKING
}

enum FinancialPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model EmployeeFinancialProfile {
  id                   String        @id @default(cuid())
  tenantId             String
  employeeDetailsId    String        @unique
  paymentMethod        PaymentMethod @default(BANK_TRANSFER)
  // Plain reference (no FK constraint) to avoid circular dependency with EmployeeBankAccount.
  // Application layer enforces that this ID belongs to the same profile.
  primaryBankAccountId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  employeeDetails EmployeeDetails          @relation(fields: [employeeDetailsId], references: [id], onDelete: Cascade)
  bankAccounts    EmployeeBankAccount[]
  taxInformation  EmployeeTaxInformation?
  paymentHistory  EmployeePaymentHistory[]

  @@index([tenantId])
  @@index([deletedAt])
  @@map("employee_financial_profiles")
}

model EmployeeBankAccount {
  id                     String          @id @default(cuid())
  tenantId               String
  financialProfileId     String
  bankName               String
  bankCode               String?
  accountType            BankAccountType
  accountNumberEncrypted String
  accountLast4           String          @db.Char(4)
  isPrimary              Boolean         @default(false)
  isActive               Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  deletedAt              DateTime?

  financialProfile EmployeeFinancialProfile @relation(fields: [financialProfileId], references: [id], onDelete: Cascade)
  paymentHistory   EmployeePaymentHistory[]

  @@index([tenantId, financialProfileId])
  @@index([tenantId, isActive])
  @@index([deletedAt])
  @@map("employee_bank_accounts")
}

model EmployeeTaxInformation {
  id                    String   @id @default(cuid())
  tenantId              String
  financialProfileId    String   @unique
  taxIdEncrypted        String
  taxIdLast4            String   @db.Char(4)
  taxRegime             String?
  withholdingApplicable Boolean  @default(false)
  withholdingRate       Decimal? @db.Decimal(5, 4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  financialProfile EmployeeFinancialProfile @relation(fields: [financialProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, financialProfileId])
  @@map("employee_tax_information")
}

model EmployeePaymentHistory {
  id                   String                 @id @default(cuid())
  tenantId             String
  financialProfileId   String
  bankAccountId        String?
  periodYear           Int
  periodMonth          Int
  grossAmount          Decimal                @db.Decimal(12, 2)
  totalDeductions      Decimal                @db.Decimal(12, 2)
  netAmount            Decimal                @db.Decimal(12, 2)
  deductionBreakdown   Json?
  paymentDate          DateTime?
  paymentMethod        PaymentMethod
  status               FinancialPaymentStatus @default(PENDING)
  transactionReference String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  financialProfile EmployeeFinancialProfile @relation(fields: [financialProfileId], references: [id], onDelete: Cascade)
  bankAccount      EmployeeBankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@unique([financialProfileId, periodYear, periodMonth])
  @@index([tenantId, financialProfileId])
  @@index([tenantId, periodYear, periodMonth])
  @@index([tenantId, status])
  @@map("employee_payment_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// RBAC — PERMISSION CATALOG (USR-02)
// ─────────────────────────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(cuid())
  code        String
  name        String
  description String?
  module      String?
  resource    String?
  action      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([code])
  @@index([module])
  @@index([resource, action])
  @@index([isActive])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum PermissionEffect {
  ALLOW
  DENY
}

model UserPermission {
  id           String           @id @default(cuid())
  userId       String
  permissionId String
  effect       PermissionEffect @default(ALLOW)
  createdAt    DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([effect])
  @@map("user_permissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// MES OPERATIONAL USERS (cédula + PIN auth)
// ─────────────────────────────────────────────────────────────────────────────

enum OperationalRole {
  OWNER
  SUPERVISOR
  MANAGER
  OPERATOR
}

model OperationalUser {
  id            String          @id @default(cuid())
  userId        String?         @unique
  cedulaHash    String
  pinHash       String
  role          OperationalRole
  tenantId      String
  sedeId        String?
  isActive      Boolean         @default(true)
  loginAttempts Int             @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  refreshToken  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user                  User?                @relation(fields: [userId], references: [id])
  operatorSessions      OperatorSession[]
  reportedIncidents     ProductionIncident[] @relation("IncidentReporter")
  resolvedIncidents     ProductionIncident[] @relation("IncidentResolver")
  responsibleExecutions PhaseExecution[]     @relation("ExecutionResponsible")
  productionLogs        ProductionLog[]

  @@unique([tenantId, cedulaHash])
  @@index([tenantId])
  @@index([tenantId, role])
  @@map("operational_users")
}

// ─────────────────────────────────────────────────────────────────────────────
// MES — PRODUCTION MASTER DATA
// ─────────────────────────────────────────────────────────────────────────────

model WorkStation {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  phases          ProductionPhase[]
  sessions        OperatorSession[]
  phaseExecutions PhaseExecution[]
  incidents       ProductionIncident[]
  productionLogs  ProductionLog[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("work_stations")
}

enum RecipeType {
  FINAL_PRODUCT
  SUB_RECIPE
  BASE_PRODUCTION
  COMBO
  SIDE
}

enum RecipeLifecycleStatus {
  TRIAL
  ACTIVE
  INACTIVE
}

enum OperationCenter {
  PLANT
  LOCATION
  ALL
}

enum TechnicalResponsible {
  CHEF
  PRODUCTION
  QUALITY
}

enum RecipeAllergen {
  GLUTEN
  DAIRY
  EGG
  NUTS
}

enum BatchDisplayUnit {
  UNIT
  PORTION
  KILOGRAM
  LITER
  TRAY
  BATCH
}

enum RecipeComponentType {
  INGREDIENT
  SUB_RECIPE
  PACKAGING
  SAUCE
  TOPPING
  DECORATION
}

enum RecipeUsageUnit {
  GRAM
  MILLILITER
  UNIT
  KILOGRAM
  LITER
  OUNCE
}

model RecipeCategory {
  id           String   @id @default(cuid())
  tenantId     String
  nombre       String
  descripcion  String?
  codePrefix   String   @default("REC")
  codeSequence Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipes ProductionRecipe[]

  @@unique([tenantId, nombre])
  @@unique([tenantId, codePrefix])
  @@index([tenantId, isActive])
  @@map("recipe_categories")
}

model ProductionRecipe {
  id                   String                @id @default(cuid())
  tenantId             String
  categoryId           String?
  code                 String?
  name                 String
  recipeType           RecipeType?
  finishedProductId    String?
  batchSize            Decimal               @db.Decimal(10, 3)
  batchUnit            StockUnit
  batchDisplayUnit     BatchDisplayUnit?
  packageWeight        Decimal?              @db.Decimal(10, 3)
  packageWeightGrams   Int?
  expectedYield        Decimal?              @db.Decimal(10, 2)
  expectedYieldUnit    String?
  estimatedMinutes     Int
  version              Int                   @default(1)
  lifecycleStatus      RecipeLifecycleStatus @default(TRIAL)
  isActive             Boolean               @default(true)
  isDraft              Boolean               @default(false)
  operationCenter      OperationCenter?
  technicalResponsible TechnicalResponsible?
  allergens            RecipeAllergen[]
  rejectionReason      String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  category         RecipeCategory?            @relation(fields: [categoryId], references: [id])
  phases           ProductionPhase[]
  orders           ProductionOrder[]
  images           RecipeImage[]
  locations        ProductionRecipeLocation[]
  statusHistory    RecipeStatusHistory[]
  compositionLines RecipeCompositionLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, categoryId, name])
  @@index([tenantId, isActive])
  @@index([tenantId, lifecycleStatus])
  @@index([tenantId, categoryId])
  @@map("production_recipes")
}

model ProductionRecipeLocation {
  id         String @id @default(cuid())
  tenantId   String
  recipeId   String
  locationId String

  recipe   ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  location Location         @relation(fields: [locationId], references: [id])

  @@unique([recipeId, locationId])
  @@index([tenantId])
  @@index([locationId])
  @@map("production_recipe_locations")
}

model RecipeStatusHistory {
  id              String                 @id @default(cuid())
  tenantId        String
  recipeId        String
  fromStatus      RecipeLifecycleStatus?
  toStatus        RecipeLifecycleStatus
  changedByUserId String?
  reason          String?
  createdAt       DateTime               @default(now())

  recipe ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipeId])
  @@index([recipeId, createdAt])
  @@map("recipe_status_history")
}

model RecipeCompositionLine {
  id            String              @id @default(cuid())
  tenantId      String
  recipeId      String
  supplyItemId  String
  componentType RecipeComponentType
  usageUnit     RecipeUsageUnit
  grossQuantity Decimal             @db.Decimal(10, 3)
  netQuantity   Decimal             @db.Decimal(10, 3)
  sortOrder     Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  recipe     ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  supplyItem SupplyItem       @relation(fields: [supplyItemId], references: [id])

  @@index([tenantId, recipeId])
  @@index([recipeId, sortOrder])
  @@map("recipe_composition_lines")
