{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "payroll/pila/templates/**/*",
        "watchAssets": true
      },
      {
        "include": "payroll/pila/serializer/fixtures/golden/**/*",
        "watchAssets": true
      }
    ]
  }
}
