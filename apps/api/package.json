{
  "name": "@restopsiq/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./jest.e2e.config.js --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npx prisma@5 migrate dev",
    "db:migrate:deploy": "npx prisma@5 migrate deploy",
    "db:migrate:reset": "npx prisma@5 migrate reset",
    "db:generate": "npx prisma@5 generate",
    "db:studio": "npx prisma@5 studio",
    "db:seed": "npx prisma@5 db seed"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^6.19.3",
    "@restopsiq/types": "*",
    "@restopsiq/utils": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@restopsiq/tsconfig": "*",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^6.3.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
