{
  "name": "@restopsiq/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./jest.e2e.config.js --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npx prisma@5 migrate dev",
    "db:migrate:deploy": "npx prisma@5 migrate deploy",
    "db:migrate:deploy:remote": "railway run sh -c 'DATABASE_URL=$DATABASE_PUBLIC_URL npx prisma@5 migrate deploy'",
    "db:migrate:reset": "npx prisma@5 migrate reset",
    "db:generate": "npx prisma@5 generate",
    "db:studio": "npx prisma@5 studio",
    "db:seed": "npx prisma@5 db seed"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.64",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@restopsiq/email": "workspace:*",
    "@restopsiq/types": "workspace:*",
    "@restopsiq/utils": "workspace:*",
    "ai": "^6.0.189",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.10.1",
    "jira.js": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "redlock": "4.2.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@restopsiq/tsconfig": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/redlock": "^4.0.8",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "npx tsx prisma/seed.ts"
  }
}
