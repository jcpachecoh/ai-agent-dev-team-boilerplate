# ─── LLM Provider ────────────────────────────────────────────────────────────
# Choose one: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (alternative)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ─── LLM Settings ─────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token with repo + issues + pull_requests scopes
GITHUB_TOKEN=your-github-token-here
GITHUB_REPO=codenix-ai/restopsiq-platform

# ─── Repository ───────────────────────────────────────────────────────────────
# Absolute path to the repo root (auto-detected if left blank)
REPO_ROOT=

# ─── Observability ────────────────────────────────────────────────────────────
# LangSmith tracing (optional — leave blank to disable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=restopsiq-ai-dev-team

# ─── Workflow ─────────────────────────────────────────────────────────────────
# Require human approval before agents write files (true/false)
REQUIRE_HUMAN_APPROVAL=true

# Max LLM calls per agent node before forcing a stop
MAX_AGENT_ITERATIONS=10
